# Copy to infra/azure.env and edit. Sourced by infra/provision.sh.
# Safe to commit the .example; never commit infra/azure.env itself.

# Must be globally unique-ish. Lowercase letters and digits only for the
# registry and storage names (Azure enforces this).
PROJECT=aibuilder

# Pick one close to you. westus2 and eastus2 both have Container Apps.
LOCATION=westus2

RESOURCE_GROUP=rg-${PROJECT}
ACR_NAME=acr${PROJECT}                 # 5-50 chars, lowercase alphanumeric only
STORAGE_ACCOUNT=st${PROJECT}data       # 3-24 chars, lowercase alphanumeric only
FILE_SHARE=appdata
KEYVAULT_NAME=kv-${PROJECT}            # 3-24 chars, globally unique
ENVIRONMENT_NAME=cae-${PROJECT}
APP_NAME=ca-${PROJECT}
IDENTITY_NAME=id-${PROJECT}
STORAGE_MOUNT_NAME=appdatamount        # no dots or dashes -- ACA rejects them

# GitHub repo that deploys this app, as owner/repo.
GITHUB_REPO=marcompsci/ai-builder-mvp
GITHUB_BRANCH=main

# Set after your first sign-in with: ./infra/provision.sh admin
# Controls who can open /admin (feedback inbox, funnel, CSV export).
ADMIN_USER_IDS=
