# Required: your Anthropic API key. Get one at https://console.anthropic.com/
# Kept server-side only - never exposed to the browser.
ANTHROPIC_API_KEY=

# Optional: override the model used for landing-page generation.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: override where local project workspaces are stored on disk.
# Must stay a path the app owns - never derived from user input.
WORKSPACES_ROOT=./data/workspaces

# Required for Claude Code editing runs (Phase 2B) and for the GitHub state
# token's HMAC signature (Phase 3A). Generate with: openssl rand -base64 32
# Never commit a real value. Kept server-side only.
WORKSPACE_SECRET_KEY=

# --- GitHub export & GitHub MCP (optional - Phase 3A, extended in Phase 5B) ---
# Only needed if you want "Connect GitHub" / repository export, or the
# agent-proposed GitHub actions (branches/PRs/issues) in the GitHub Actions
# panel, to work. Both features share this one GitHub App - no separate
# credentials needed for GitHub MCP.
# Register a GitHub App at https://github.com/settings/apps/new with:
#   - Repository permissions: Contents (Read & write), Metadata (Read-only)
#   - (Optional, only if you want "create new repository" to work on an
#     organization account) Organization permissions: Administration (Read & write)
#   - Callback URL: http://localhost:3000/api/github/callback
#   - Setup URL / post-installation redirect: same callback URL, "Redirect on update" on
#   - Webhook: can be left disabled for this app
# All of these are kept server-side only and are never sent to the browser,
# logged, or returned from any API response.
GITHUB_APP_SLUG=
GITHUB_APP_ID=
# Paste the app's private key PEM here with literal \n in place of real
# newlines (the app decodes them back at runtime), e.g.:
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEow...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_PRIVATE_KEY=

# --- Second coding agent: Codex (optional - Phase 4) ---
# Only needed if you want to select "Codex" instead of "Claude Code" for
# editing runs. Get a key at https://platform.openai.com/api-keys
# Kept server-side only - never exposed to the browser. If unset, "Codex" is
# shown as unavailable in the agent selector rather than failing at request time.
OPENAI_API_KEY=

# Recommended future design (not yet implemented): bring-your-own-key.
# Today both ANTHROPIC_API_KEY and OPENAI_API_KEY are this app's own
# development-mode credentials, shared across every project. A production
# version should let each user supply and store their own key (encrypted at
# rest, the same way GitHub App credentials avoid persisting raw secrets -
# see docs/security.md), scoped per user/workspace rather than per
# deployment, so no one project's usage is billed against another's key.
